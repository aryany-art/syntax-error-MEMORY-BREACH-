[node name="World" type="Node2D"]
script = ExtResource("world_settings")
mission_title = "Neural Bridge"
briefing = "Cross the fortified bridge checkpoints. Synchronize the rescue link so Elena can leave without exposing the citizens' private memories."
hint = "Fight through the 4 fortified bridge checkpoints or hack their override terminals."
time_limit = 290.0
camera_bounds = Rect2(0, -100, 960, 720)
arrival_message = "AETHER: I CAN HOLD THE ARCHIVE. YOU MUST OPEN THE BRIDGE. YARROW: You are abandoning your purpose, Patch. PATCH: I am deciding what it means."
memory_fragment = "MEMORY 09: Bot_404 is a rescue chassis with an independent power supply. Elena can leave the network without dragging the citizens' private memories with her."
completion_text = "The bridge synchronizes. AETHER publishes the signed warrant and consent audit, never the private memories. The final core lock is all that separates Elena from the outside."
metadata/title = "Neural Bridge"

