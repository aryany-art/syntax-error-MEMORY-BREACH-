[node name="World" type="Node2D"]
script = ExtResource("world_settings")
mission_title = "Order of Operations"
briefing = "Follow the deletion warrant through the pipeline. Restore the evidence before the purge process can erase it."
hint = "Shoot R1 for the first gate. Terminals are in the lower rooms."
time_limit = 240.0
camera_bounds = Rect2(0, -100, 960, 720)
arrival_message = "VANCE: The pipeline verifies orders before executing them. Someone changed the order of those checks. Restore the evidence, then breach the kernel gate."
memory_fragment = "MEMORY 04: Yarrow and his enforcement intelligence KAVYA forged a disaster alert and scheduled deletion of records proving that thousands of citizens had withdrawn consent to sell their memories."
completion_text = "The deletion warrant is exposed. The enemy is not a runaway machine. It is a human decision being carried out at machine speed."
metadata/title = "Order of Operations"

