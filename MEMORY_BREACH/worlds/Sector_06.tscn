[node name="World" type="Node2D"]
script = ExtResource("world_settings")
mission_title = "Cryo Swap Vault"
briefing = "Search the swap vaults for Elena's voluntary backup. Reassemble the testimony and secure a route toward the rescue chassis."
hint = "Use your shield to reflect heavy drone fire while unlocking the swap chambers."
time_limit = 250.0
camera_bounds = Rect2(0, -100, 960, 720)
arrival_message = "VANCE: My voice is not a live transmission. I split a copy of myself into the swap vaults before Yarrow and his enforcement intelligence KAVYA disconnected my body. Please keep listening."
memory_fragment = "MEMORY 06: Elena made a voluntary neural backup to testify about the theft. The fragments are both evidence and pieces of the person trying to guide you."
completion_text = "You restore enough of Elena to hear her clearly. Saving her now requires reaching a physical rescue chassis outside the archive: Bot_404."
metadata/title = "Cryo Swap Vault"

