[node name="World" type="Node2D"]
script = ExtResource("world_settings")
mission_title = "KAVYA: The Last Protocol"
briefing = "Break KAVYA's control of the rescue bridge. Recover the scattered memories, defeat or breach her, collect the final shard she releases, and reach extraction."
hint = "Open OUTER_FW, CORE_CHAMBER and EXIT_LOCK with the one-protocol gate buttons. Collect every memory. Defeat or disable KAVYA, collect the final shard she releases, then reach extraction. Sleep commands require Developer Cheats Enabled."
time_limit = 900.0
camera_bounds = Rect2(0, -100, 960, 720)
arrival_message = "KAVYA: I am the last signature on every order you broke. VANCE: She was built to enforce ownership, Patch. Her crown controls the reinforcements. Break her one authentication protocol or fight through her armor. AETHER: Bot_404 is waiting."
memory_fragment = "MEMORY 10: Elena's final instruction was not save me at any cost. It was preserve their choice. You can restore her while leaving every other memory under its owner's control."
completion_text = "KAVYA's crown goes dark. Without its enforcement signature, the purge order expires. Elena opens her eyes inside Bot_404 while AETHER returns the archive to its citizens. Patch keeps the broken crown as a reminder: a system is not just when it obeys perfectly, but when it can refuse an unjust order."
metadata/title = "The Human Exception"

