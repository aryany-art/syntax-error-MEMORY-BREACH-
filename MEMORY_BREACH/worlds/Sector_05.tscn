[node name="World" type="Node2D"]
script = ExtResource("world_settings")
mission_title = "Subnet Crossfire"
briefing = "Recover the quarantine records and compare them with the corporate warrant. Open the subnet route to reach AETHER."
hint = "Shoot both R1 and R2 optic switches, or hack the subnet gates."
time_limit = 240.0
camera_bounds = Rect2(0, -100, 960, 720)
arrival_message = "AETHER: QUARANTINE PRESERVES LIFE. YARROW: Ignore that damaged system. VANCE: Compare its actions with the warrant. Decide which one the evidence supports."
memory_fragment = "MEMORY 05: AETHER sealed the archive to stop an unlawful transfer. Its quarantine bought time, but corporate security still controls the gates and purge scheduler."
completion_text = "AETHER was protecting the people inside. You send it the consent records. For the first time it answers without an error: WITNESS ACCEPTED."
metadata/title = "Subnet Crossfire"

