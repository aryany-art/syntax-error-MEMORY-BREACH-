[node name="World" type="Node2D"]
script = ExtResource("world_settings")
mission_title = "Heuristic Maze"
briefing = "Recover Patch's credentials from the heuristic chambers. Unlock the path to the purge scheduler."
hint = "Approach each gate and select BREACH GATE, or shoot R1/R2. Solve one displayed numeric protocol; old alpha/beta/gamma codes select a gate challenge rather than opening it directly."
time_limit = 260.0
camera_bounds = Rect2(0, -100, 960, 720)
arrival_message = "PATCH: My own credentials are missing. AETHER: YOU ARE PATCH, A MAINTENANCE INTELLIGENCE. VANCE: I taught you to question an order when obedience would hurt someone."
memory_fragment = "MEMORY 07: Patch was not a hired hacker. Elena created the repair intelligence to protect consent, then trusted it with the freedom to refuse her too."
completion_text = "You stop searching for a forgotten human identity. You are the one making these choices. Patch keeps the name and opens the route toward the purge engine."
metadata/title = "Heuristic Maze"

