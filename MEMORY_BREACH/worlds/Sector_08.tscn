[node name="World" type="Node2D"]
script = ExtResource("world_settings")
mission_title = "Garbage Collector"
briefing = "Disable the purge queue without destroying the archive. Search the corner rooms and open the east vault."
hint = "You start in the center hub! Grab the clues in the 4 corners to breach the east vault."
time_limit = 280.0
camera_bounds = Rect2(0, -100, 960, 720)
arrival_message = "AETHER: PURGE QUEUE ACTIVE. VANCE: Do not destroy the archive. Stop the scheduler. Every shard you carry is a person's chance to be remembered on their own terms."
memory_fragment = "MEMORY 08: The garbage collector is preparing to erase the witnesses, including Elena. Disabling it preserves their memories without giving anyone ownership of them."
completion_text = "The purge queue stops. The archive is safe for the moment, but Yarrow and his enforcement intelligence KAVYA locks the external bridge. Elena cannot reach Bot_404 until its four checkpoints are breached."
metadata/title = "Garbage Collector"

