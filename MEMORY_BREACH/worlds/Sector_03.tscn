[node name="World" type="Node2D"]
script = ExtResource("world_settings")
mission_title = "Sentry Relocation"
briefing = "Investigate the sentry audit to identify who ordered the lockdown. Recover the records and escape the patrol network."
hint = "Shoot drones, shield their bolts, and read both terminals."
time_limit = 200.0
camera_bounds = Rect2(0, -100, 960, 720)
arrival_message = "YARROW: Unauthorized process. Those fragments are stolen property. VANCE: Listen to how he says property. Keep going, Patch. Find the sentry audit."
memory_fragment = "MEMORY 03: The sentries were ordered to hunt archive access keys. Elena added a sleep command so emergency workers could stop them without destroying the machines."
completion_text = "A sentry audit proves the lockdown was deliberate. The hostile drones are following a contract, not choosing sides. You now know who signed it."
metadata/title = "Sentry Relocation"

