[node name="World" type="Node2D"]
script = ExtResource("world_settings")
mission_title = "Aegis Refraction"
briefing = "Cross the hospital security grid and recover the Aegis test logs. Open the exit route while conserving shield energy."
hint = "Hold SHIELD to cross the laser, or hack laser.power = off. Shoot R1 to open the gate."
time_limit = 180.0
camera_bounds = Rect2(0, -100, 960, 720)
arrival_message = "PATCH: The Aegis shield recognizes my signal. VANCE: I wrote its emergency protocol. It protects rescuers, not soldiers. Use it to survive the security grid."
memory_fragment = "MEMORY 02: Aegis was tested in a hospital, shielding patients during evacuation. A corporate signature later relabeled the rescue hardware as restricted military equipment."
completion_text = "The hospital logs survive. Every security order carries the same issuer: Yarrow and his enforcement intelligence KAVYA, the executive who now owns the network carrying the city's memories."
metadata/title = "Aegis Refraction"

