[node name="World" type="Node2D"]
script = ExtResource("world_settings")
mission_title = "Permission Denied"
briefing = "Restore access to the first archive chamber. Recover its violet memories and consent record, unlock the route, and reach extraction."
hint = "Walk to the amber terminal, press HACK, run the code, or blast the patrol scout."
time_limit = 150.0
camera_bounds = Rect2(0, -100, 960, 720)
arrival_message = "VANCE: Patch, if you can hear me, the city has six minutes before its memory archive begins purging. Find my fragments. Trust the evidence, even when you cannot trust my voice."
memory_fragment = "MEMORY 01: Elena Vance built AETHER to preserve citizens' memories after neural illness. The archive was meant to belong to the people whose lives it held."
completion_text = "You recover the first consent record. The lock was not hiding weapons; it was hiding names. Vance asks you to trace the order that revoked their access."
metadata/title = "Permission Denied"

